{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023"],

        "paths": {
            "@/*": ["./src/*"]
        },

        "module": "node16",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        "outDir": "./dist",
        "rootDir": "./src",

        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "src/knexfile.ts"
    ]
}
